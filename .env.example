# Frontend (Create React App) environment variables.
# On Vercel, set this to your deployed backend URL.
REACT_APP_API_BASE_URL=/api

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# REACT_APP_GA_MEASUREMENT_ID=

# Backend (also set these in Vercel Project → Settings → Environment Variables)
# MONGODB_URI=
# MONGODB_DB_NAME=
# JWT_SECRET_KEY=

# Blog auto-generation — prefer Z.ai (https://z.ai/manage-apikey/apikey-list)
# ZAI_API_KEY=
# ZAI_MODEL=glm-4.5-flash
# GROQ_API_KEY=
# GEMINI_API_KEY=
# BLOG_PROVIDER=zai
# BLOG_DAILY_LIMIT=10
# Unsplash (blog cover images) — Access Key from https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=
# Pixabay (blog cover images) — https://pixabay.com/api/docs/
# PIXABAY_API_KEY=
# Ticketmaster Discovery API (optional legacy)
# TICKETMASTER_API_KEY=
# TICKETMASTER_API_SECRET=
# Shared secret for daily cron (also set Vercel CRON_SECRET for Authorization bearer)
# BLOG_CRON_SECRET=
# CRON_SECRET=

# Consultation form → email (Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=aeromekai@gmail.com
# SMTP_PASSWORD=
# SMTP_TO=aeromekai@gmail.com
